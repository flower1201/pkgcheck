{
  "name": "pkgcheck",
  "version": "0.1.0-rc.1",
  "description": "Offline package.json readiness lint for AI-generated manifests.",
  "type": "module",
  "bin": {
    "pkgcheck": "./dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "demo": "npm run build && node ./scripts/demo.mjs"
  },
  "keywords": [
    "cli",
    "developer-tools",
    "typescript",
    "local-first",
    "ai-coding"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flower1201/pkgcheck.git"
  },
  "homepage": "https://github.com/flower1201/pkgcheck#readme",
  "bugs": {
    "url": "https://github.com/flower1201/pkgcheck/issues"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9",
    "@types/node": "^22.13.10"
  }
}